{
  "name": "agent-tab-bridge",
  "version": "0.1.0",
  "description": "Explicit shared-tab co-browsing bridge for Brave",
  "license": "MIT",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "agent-tab-bridge-relay": "./dist/src/agent-tab-bridge-relay.js"
  },
  "files": [
    "dist/",
    "LICENSE",
    "README.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "test:relay": "vitest run extensions/browser/chrome-extension/modules/relay-core.test.ts extensions/browser/src/browser/extension-relay/relay-protocol.test.ts extensions/browser/src/browser/extension-relay/relay-bridge.test.ts extensions/browser/src/browser/extension-relay/relay-server.test.ts",
    "start": "node dist/src/agent-tab-bridge-relay.js"
  },
  "dependencies": {
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@types/ws": "^8.5.14",
    "typescript": "^5.8.3",
    "vitest": "^3.1.2"
  }
}

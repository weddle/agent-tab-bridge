{
  "name": "agent-tab-bridge",
  "version": "0.1.0",
  "description": "Explicit shared-tab co-browsing bridge for Brave",
  "license": "MIT",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "atb": "./dist/src/atb.js"
  },
  "files": [
    "dist/",
    "extensions/",
    "!extensions/**/*.test.ts",
    "LICENSE",
    "README.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.json && chmod 755 dist/src/atb.js",
    "prepack": "npm run build",
    "test": "vitest run src extensions/browser/chrome-extension/modules extensions/browser/src/browser/extension-relay",
    "start": "node dist/src/atb.js"
  },
  "dependencies": {
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@types/ws": "^8.5.14",
    "typescript": "^5.8.3",
    "vitest": "^3.1.2"
  }
}

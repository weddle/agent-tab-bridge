{
  "manifest_version": 3,
  "name": "Agent Tab Bridge",
  "version": "1.0.0",
  "description": "Approve isolated local task sessions for Agent Tab Bridge.",
  "icons": {
    "16": "icons/agent-tab-bridge-16.png",
    "32": "icons/agent-tab-bridge-32.png",
    "48": "icons/agent-tab-bridge-48.png",
    "128": "icons/agent-tab-bridge-128.png"
  },
  "key": "MFkwEwYHKoZIzj0CAQYIKoZIzj0DAQcDQgAEK7xq73dCByVjSyuH/uoToX3IeSvK0a3V/9DepSsG9BAmkLUFfIZrmW8pgSIm3Oz2Au+F+eM8rK+bjOuCiRuCEw==",
  "permissions": [
    "debugger",
    "nativeMessaging",
    "tabs",
    "storage",
    "tabGroups"
  ],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": {
    "default_title": "Agent Tab Bridge",
    "default_icon": {
      "16": "icons/agent-tab-bridge-16.png",
      "32": "icons/agent-tab-bridge-32.png",
      "48": "icons/agent-tab-bridge-48.png",
      "128": "icons/agent-tab-bridge-128.png"
    },
    "default_popup": "popup.html"
  },
  "minimum_chrome_version": "125"
}

{
  "manifest_version": 3,
  "name": "Agent Tab Bridge",
  "version": "1.0.0",
  "description": "Explicitly share Brave tabs with a paired local agent through the Agent Tabs group.",
  "permissions": [
    "debugger",
    "tabs",
    "tabGroups",
    "storage",
    "alarms"
  ],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": {
    "default_title": "Agent Tab Bridge",
    "default_popup": "popup.html"
  },
  "minimum_chrome_version": "125"
}
